# -----------------------------
# Database
# -----------------------------
# 앱 실행, Prisma generate, build에 사용하는 DB 연결 URL
DATABASE_URL=""

# Prisma migration 및 DB schema 변경 담당자용 direct DB URL
# 일반 개발자는 없어도 됩니다.
# 필요한 경우에만 주석을 해제해서 사용하세요.
# DIRECT_URL=""


# -----------------------------
# Auth / Token Secret
# -----------------------------
# 인증 및 토큰 서명/검증에 사용하는 서버 전용 secret
AUTH_SECRET=""
ACCESS_TOKEN_SECRET=""
REFRESH_TOKEN_SECRET=""


# -----------------------------
# External API Keys
# -----------------------------
# 서버에서 호출하는 외부 API key
WEATHER_API_KEY=""
CULTURE_API_KEY=""
DUST_API_KEY=""
GEMINI_API_KEY=""


# -----------------------------
# Public Client Keys
# -----------------------------
# 브라우저에서 사용하는 public key
# NEXT_PUBLIC_ prefix가 붙은 값은 클라이언트에 노출될 수 있습니다.
NEXT_PUBLIC_KAKAO_MAP_KEY=""
