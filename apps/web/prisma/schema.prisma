generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(uuid()) @db.Uuid
  email     String    @unique @db.VarChar(255)
  nickname  String?   @db.VarChar(100)
  role      String    @default("user") @db.VarChar(50)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  authCredential      AuthCredential?
  refreshTokens       RefreshToken[]
  explorationSessions ExplorationSession[]
  favorites           Favorite[]
  eventLogs           EventLog[]

  @@map("users")
}

model AuthCredential {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @map("user_id") @db.Uuid
  passwordHash String   @map("password_hash") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_credentials")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model ExplorationSession {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String?   @map("user_id") @db.Uuid
  sessionKey  String    @map("session_key") @db.VarChar(255)
  isGuest     Boolean   @default(true) @map("is_guest")
  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  user               User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  explorationAnswers ExplorationAnswer[]
  recommendationRuns RecommendationRun[]
  eventLogs          EventLog[]

  @@index([sessionKey])
  @@index([userId])
  @@index([completedAt])
  @@map("exploration_sessions")
}

model ExplorationAnswer {
  id          String   @id @default(uuid()) @db.Uuid
  sessionId   String   @map("session_id") @db.Uuid
  questionKey String   @map("question_key") @db.VarChar(100)
  answerValue String   @map("answer_value") @db.VarChar(255)
  answerLabel String?  @map("answer_label") @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")

  session ExplorationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([questionKey])
  @@unique([sessionId, questionKey])
  @@map("exploration_answers")
}

model Tag {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(100)
  name      String   @db.VarChar(100)
  type      String   @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")

  eventItemTags EventItemTag[]

  @@index([type])
  @@map("tags")
}

model EventItem {
  id          String    @id @default(uuid()) @db.Uuid
  externalId  String?   @unique @map("external_id") @db.VarChar(255)
  title       String    @db.VarChar(255)
  description String?   @db.Text
  realmCode   String?   @map("realm_code") @db.VarChar(50)
  category    String?   @db.VarChar(100)
  placeName   String?   @map("place_name") @db.VarChar(255)
  address     String?   @db.VarChar(500)
  latitude    Decimal?  @db.Decimal(10, 7)
  longitude   Decimal?  @db.Decimal(10, 7)
  startDate   DateTime? @map("start_date") @db.Date
  endDate     DateTime? @map("end_date") @db.Date
  priceText   String?   @map("price_text") @db.VarChar(255)
  imageUrl    String?   @map("image_url") @db.Text
  externalUrl String?   @map("external_url") @db.Text
  isIndoor    Boolean?  @map("is_indoor")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  eventItemTags       EventItemTag[]
  recommendationItems RecommendationItem[]
  favorites           Favorite[]
  eventLogs           EventLog[]

  @@index([externalId])
  @@index([realmCode])
  @@index([startDate])
  @@index([endDate])
  @@index([isIndoor])
  @@index([latitude, longitude])
  @@map("event_items")
}

model EventItemTag {
  eventItemId String   @map("event_item_id") @db.Uuid
  tagId       String   @map("tag_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  eventItem EventItem @relation(fields: [eventItemId], references: [id], onDelete: Cascade)
  tag       Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([eventItemId, tagId])
  @@index([tagId])
  @@map("event_item_tags")
}

model WeatherSnapshot {
  id                       String   @id @default(uuid()) @db.Uuid
  locationKey              String?  @map("location_key") @db.VarChar(255)
  latitude                 Decimal? @db.Decimal(10, 7)
  longitude                Decimal? @db.Decimal(10, 7)
  weatherStatus            String?  @map("weather_status") @db.VarChar(100)
  temperature              Decimal? @db.Decimal(5, 2)
  precipitationType        String?  @map("precipitation_type") @db.VarChar(100)
  precipitationProbability Int?     @map("precipitation_probability")
  rawPayload               Json?    @map("raw_payload") @db.JsonB
  createdAt                DateTime @default(now()) @map("created_at")

  recommendationRuns RecommendationRun[]

  @@index([locationKey])
  @@index([createdAt])
  @@map("weather_snapshots")
}

model RecommendationRun {
  id                   String   @id @default(uuid()) @db.Uuid
  sessionId            String   @map("session_id") @db.Uuid
  weatherSnapshotId    String?  @map("weather_snapshot_id") @db.Uuid
  resultCount          Int      @map("result_count")
  situationSummary     String?  @map("situation_summary") @db.Text
  weatherSummary       String?  @map("weather_summary") @db.Text
  recommendationReason String?  @map("recommendation_reason") @db.Text
  createdAt            DateTime @default(now()) @map("created_at")

  session             ExplorationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  weatherSnapshot     WeatherSnapshot?   @relation(fields: [weatherSnapshotId], references: [id], onDelete: SetNull)
  recommendationItems RecommendationItem[]

  @@index([sessionId])
  @@index([weatherSnapshotId])
  @@index([createdAt])
  @@map("recommendation_runs")
}

model RecommendationItem {
  id                  String   @id @default(uuid()) @db.Uuid
  recommendationRunId String   @map("recommendation_run_id") @db.Uuid
  eventItemId         String   @map("event_item_id") @db.Uuid
  rank                Int
  score               Decimal? @db.Decimal(8, 4)
  reason              String?  @db.Text
  createdAt           DateTime @default(now()) @map("created_at")

  recommendationRun RecommendationRun @relation(fields: [recommendationRunId], references: [id], onDelete: Cascade)
  eventItem         EventItem         @relation(fields: [eventItemId], references: [id], onDelete: Cascade)

  @@unique([recommendationRunId, eventItemId])
  @@unique([recommendationRunId, rank])
  @@index([recommendationRunId])
  @@index([eventItemId])
  @@index([rank])
  @@map("recommendation_items")
}

model Favorite {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  eventItemId String   @map("event_item_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventItem EventItem @relation(fields: [eventItemId], references: [id], onDelete: Cascade)

  @@unique([userId, eventItemId])
  @@index([userId])
  @@index([eventItemId])
  @@index([createdAt])
  @@map("favorites")
}

model EventLog {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  sessionId   String?  @map("session_id") @db.Uuid
  eventItemId String?  @map("event_item_id") @db.Uuid
  eventName   String   @map("event_name") @db.VarChar(100)
  metadata    Json?    @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at")

  user      User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  session   ExplorationSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  eventItem EventItem?          @relation(fields: [eventItemId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([sessionId])
  @@index([eventItemId])
  @@index([eventName])
  @@index([createdAt])
  @@map("event_logs")
}
